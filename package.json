{
  "name": "free-to-keep-game-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Detect free-to-keep game promotions, publish them, and retain append-only reports.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run format:check && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "tsx src/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:buffer": "tsx src/verify-buffer.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cheerio": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
